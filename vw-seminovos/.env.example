# Copie para .env e preencha com os dados do seu stack.
# Grafana Cloud > My Account > seu stack > "Details" em Prometheus, Loki e Tempo.
# Cada token precisa do escopo de escrita do respectivo sinal (metrics:write, logs:write, traces:write).

GRAFANA_PROMETHEUS_URL=https://prometheus-prod-XX-prod-REGIAO.grafana.net/api/prom/push
GRAFANA_PROMETHEUS_USER=000000
GRAFANA_PROMETHEUS_TOKEN=glc_SEU_TOKEN

GRAFANA_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=000000
GRAFANA_LOKI_TOKEN=glc_SEU_TOKEN

GRAFANA_TEMPO_URL=https://tempo-prod-XX-prod-REGIAO.grafana.net/tempo
GRAFANA_TEMPO_OTLP_ENDPOINT=tempo-prod-XX-prod-REGIAO.grafana.net:443
GRAFANA_TEMPO_USER=000000
GRAFANA_TEMPO_TOKEN=glc_SEU_TOKEN

DEPLOY_ENV=lab
MYSQL_EXPORTER_DSN=exporter:exporter_pass@(db:3306)/
