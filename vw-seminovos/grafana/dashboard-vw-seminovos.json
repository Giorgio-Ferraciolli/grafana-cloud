{
  "title": "VW Seminovos - Visão geral",
  "uid": "vw-seminovos-overview",
  "tags": ["vw-seminovos", "alloy"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      { "name": "prom", "label": "Prometheus", "type": "datasource", "query": "prometheus", "hide": 0, "refresh": 1, "current": {} },
      { "name": "loki", "label": "Loki", "type": "datasource", "query": "loki", "hide": 0, "refresh": 1, "current": {} }
    ]
  },
  "panels": [
    {
      "type": "stat", "title": "Requisições/s (API)", "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${prom}" },
        "expr": "sum(rate(http_requests_total{job=\"vw-backend\"}[$__rate_interval]))" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "type": "stat", "title": "Latência p95 (API)", "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${prom}" },
        "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"vw-backend\"}[$__rate_interval])))" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.3 }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "type": "stat", "title": "Erros 5xx (API)", "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${prom}" },
        "expr": "(sum(rate(http_requests_total{job=\"vw-backend\",status=\"5xx\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_requests_total{job=\"vw-backend\"}[$__rate_interval])), 1e-9)" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "type": "stat", "title": "Propostas no período", "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "targets": [{ "refId": "A", "instant": true, "datasource": { "type": "prometheus", "uid": "${prom}" },
        "expr": "round(sum(increase(vw_leads_created_total[$__range])) or vector(0))" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "value" }
    },
    {
      "type": "stat", "title": "Test drives no período", "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "targets": [{ "refId": "A", "instant": true, "datasource": { "type": "prometheus", "uid": "${prom}" },
        "expr": "round(sum(increase(vw_test_drives_created_total[$__range])) or vector(0))" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "value" }
    },
    {
      "type": "stat", "title": "Avaliações de usado no período", "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "targets": [{ "refId": "A", "instant": true, "datasource": { "type": "prometheus", "uid": "${prom}" },
        "expr": "round(sum(increase(vw_sell_requests_total[$__range])) or vector(0))" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "value" }
    },
    {
      "type": "timeseries", "title": "Requisições/s por rota", "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${prom}" },
        "expr": "sum by (method, handler) (rate(http_requests_total{job=\"vw-backend\"}[$__rate_interval]))",
        "legendFormat": "{{method}} {{handler}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean"] } }
    },
    {
      "type": "timeseries", "title": "Latência p95 por rota", "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${prom}" },
        "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{job=\"vw-backend\"}[$__rate_interval])))",
        "legendFormat": "{{handler}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] } }
    },
    {
      "type": "bargauge", "title": "Propostas por modelo (período)", "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "targets": [{ "refId": "A", "instant": true, "datasource": { "type": "prometheus", "uid": "${prom}" },
        "expr": "sort_desc(round(sum by (model) (increase(vw_leads_created_total[$__range]))))", "legendFormat": "{{model}}" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries", "title": "CPU por container", "gridPos": { "x": 8, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${prom}" },
        "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{job=\"integrations/docker\", project=\"vw-seminovos\"}[$__rate_interval]))",
        "legendFormat": "{{name}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Memória por container", "gridPos": { "x": 16, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${prom}" },
        "expr": "sum by (name) (container_memory_working_set_bytes{job=\"integrations/docker\", project=\"vw-seminovos\"})",
        "legendFormat": "{{name}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "MySQL: conexões e queries/s", "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${prom}" },
          "expr": "mysql_global_status_threads_connected{instance=\"vw-db\"}", "legendFormat": "conexões" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${prom}" },
          "expr": "rate(mysql_global_status_queries{instance=\"vw-db\"}[$__rate_interval])", "legendFormat": "queries/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Alloy: envio ao Grafana Cloud (por minuto)", "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${prom}" },
          "expr": "sum(rate(prometheus_remote_storage_samples_total{project=\"vw-seminovos\"}[$__rate_interval])) * 60", "legendFormat": "amostras de métricas" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${prom}" },
          "expr": "sum(rate(loki_write_sent_entries_total{project=\"vw-seminovos\"}[$__rate_interval])) * 60", "legendFormat": "linhas de log" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${prom}" },
          "expr": "sum(rate(otelcol_exporter_sent_spans_total{project=\"vw-seminovos\"}[$__rate_interval])) * 60", "legendFormat": "spans" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "${prom}" },
          "expr": "sum(rate(prometheus_remote_storage_samples_failed_total{project=\"vw-seminovos\"}[$__rate_interval])) * 60", "legendFormat": "falhas (métricas)" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "logs", "title": "Logs com erro ou aviso (todos os serviços)", "gridPos": { "x": 0, "y": 28, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "targets": [{ "refId": "A", "datasource": { "type": "loki", "uid": "${loki}" },
        "expr": "{project=\"vw-seminovos\", level=~\"error|warning\"}" }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "type": "logs", "title": "Eventos de negócio do backend", "gridPos": { "x": 0, "y": 38, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "targets": [{ "refId": "A", "datasource": { "type": "loki", "uid": "${loki}" },
        "expr": "{service_name=\"vw-backend\"} | json | logger=\"vw.api\"" }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    }
  ]
}
