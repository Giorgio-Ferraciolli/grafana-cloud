# Laboratório: senhas e tokens de todo o compose. NÃO versionar o .env.
#   cp .env.example .env && chmod 600 .env    e preencha

# --- PostgreSQL (postgres-lab) ---
# Gere senhas aleatórias (só letras e números: entram em URLs de conexão):
#   openssl rand -hex 24
#
# As três só valem na CRIAÇÃO do volume (o initdb roda uma vez). Para trocar depois:
#   docker compose down -v   (apaga os dados) e suba de novo.

# Superusuário "postgres" (administração)
POSTGRES_PASSWORD=

# Usuário "lab_app": as duas APIs (o compose passa como DB_PASSWORD para elas)
APP_DB_PASSWORD=

# Usuário "db-o11y": o Alloy (o compose monta o POSTGRES_DSN com ela)
MONITOR_DB_PASSWORD=

# --- Grafana Cloud (alloy) ---
PROM_URL=https://prometheus-prod-40-prod-sa-east-1.grafana.net/api/prom/push
PROM_USER=
PROM_TOKEN=

LOKI_URL=https://logs-prod-024.grafana.net/loki/api/v1/push
LOKI_USER=
LOKI_TOKEN=

# Tempo via OTLP/gRPC: host:porta, sem https:// e sem /tempo
TEMPO_ENDPOINT=tempo-prod-17-prod-sa-east-1.grafana.net:443
TEMPO_USER=
TEMPO_TOKEN=

# Profiles (Pyroscope)
PYROSCOPE_URL=https://profiles-prod-017.grafana.net
PYROSCOPE_USER=
PYROSCOPE_TOKEN=
