# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=planner
MYSQL_USER=planner
MYSQL_PASSWORD=change-me

# Used by the backend (Prisma). Must stay in sync with the MYSQL_* values
# above - the "mysql" host below is the service name on the Docker network.
DATABASE_URL=mysql://planner:change-me@mysql:3306/planner

# ---------------------------------------------------------------------------
# Backend <-> Frontend
# ---------------------------------------------------------------------------
# Origin allowed by the backend's CORS policy (where the browser runs).
FRONTEND_URL=http://localhost:3000

# Base URL the BROWSER uses to reach the backend API. Baked into the
# frontend build, so it must be reachable from your machine, not just from
# inside the Docker network.
VITE_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# OpenTelemetry / Grafana Cloud
# ---------------------------------------------------------------------------
OTEL_SERVICE_NAME=planner-backend
OTEL_SERVICE_VERSION=1.0.0

# Wire format for the backend's own OTLP export. Grafana Cloud's quickstart
# recommends "http/protobuf" (the default below); "http/json" also works.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Leave empty to just print traces/metrics to the backend's console.
# Point it at Grafana Cloud's OTLP gateway to ship real telemetry, e.g.:
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# or at a local collector (e.g. an OTLP receiver added to an existing Alloy):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Required when pointing at Grafana Cloud: Basic auth header built from your
# stack's Instance ID and a Cloud Access Policy token with metrics/traces
# write scope, base64-encoded as "instanceID:token".
#   OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64(instanceID:token)>
OTEL_EXPORTER_OTLP_HEADERS=

OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# ---------------------------------------------------------------------------
# Grafana Agent Observability (AI coach note feature)
# ---------------------------------------------------------------------------
# All five values below come from the Connection tab of the Agent
# Observability plugin in your stack:
#   https://<your-stack>.grafana.net/plugins/grafana-agento11y-app
# Create a token there ("Create a token in Cloud Access Policies") scoped
# with sigil:write, metrics:write, traces:write, logs:write. The same token
# also works for OTEL_EXPORTER_OTLP_HEADERS above if it has all four scopes.
AGENTO11Y_ENDPOINT=
# Required for Grafana Cloud - the SDK defaults (grpc / no-auth) silently
# 401 against the Cloud HTTP ingest endpoint otherwise.
AGENTO11Y_PROTOCOL=http
AGENTO11Y_AUTH_MODE=basic
AGENTO11Y_AUTH_TENANT_ID=
AGENTO11Y_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Anthropic (AI coach note feature)
# ---------------------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
